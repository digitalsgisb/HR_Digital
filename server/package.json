{
  "name": "@hr-training/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "test": "tsx --test src/importer.test.ts src/dashboard-summary.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init_foundation",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hr-training/shared": "*",
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "read-excel-file": "^5.8.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.10",
    "prisma": "^6.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
