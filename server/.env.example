DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_training_tracker?schema=public"
SERVER_PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
TRUST_PROXY=false
NODE_ENV="development"

# Developer email tests: preview captures locally; smtp sends to permitted test recipients only.
EMAIL_TRANSPORT=preview
SMTP_TEST_RECIPIENTS=""
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HR Digital <developer@hr-digital.test>"

# Automatically deliver queued training invitations, reminders and follow-ups via SMTP.
EMAIL_AUTOMATION_ENABLED=true

# Optional public origin for trainee QR check-in. Blank uses CLIENT_ORIGIN in production.
ATTENDANCE_BASE_URL=""
