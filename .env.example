# Linux AI PC + tunnel deployment settings.
POSTGRES_PASSWORD="replace-with-a-long-random-password"
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=4000
CLIENT_ORIGIN="https://hr.sugidigital.org"
TRUST_PROXY=true

# Optional on-prem vision OCR. Leave blank to use the browser's bundled OCR only.
# For Ollama on the Docker host, keep the compose host-gateway entry and use this URL.
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_VISION_MODEL="qwen2.5vl:7b"

# Add SMTP credentials on the Linux server before enabling real email delivery.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Human Resource Digital <training@sugiharagrand.com>"
